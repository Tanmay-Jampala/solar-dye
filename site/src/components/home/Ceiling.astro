---
// "THE CEILING": the small blue card in the intro grows into a full-viewport panel. With WebGL
// (desktop, motion allowed) a bending plane on the page canvas does the growing and this panel is
// pinned in a scroll track (html.gl-ceil); without it, the panel is a plain section.
// When open it holds the Shockley-Queisser chart, drawn from sq.curve, with a draggable gap cursor
// that reads the stored points (src/scripts/ceiling.ts).
import Num from '../Num.astro';
import Figure from '../Figure.astro';
import { get } from '../../lib/data';
import { formatText } from '../../lib/format';

const curve: { gap_eV: number[]; efficiency: number[] } = get('sq.curve');
const optGap: number = get('sq.optimum_gap_eV');
const optEff: number = get('sq.optimum_efficiency');
const secGap: number = get('sq.secondary_peak.gap_eV');
const secEff: number = get('sq.secondary_peak.efficiency');

// Chart geometry (SVG user units). Axis ranges are presentation choices, not results.
const W = 1000, H = 560, L = 70, R = 30, T = 30, B = 60;
const xMin = curve.gap_eV[0], xMax = curve.gap_eV[curve.gap_eV.length - 1];
const yMax = Math.ceil((Math.max(...curve.efficiency) * 100) / 5) * 5 / 100;
const sx = (x: number) => L + ((x - xMin) / (xMax - xMin)) * (W - L - R);
const sy = (y: number) => H - B - (y / yMax) * (H - T - B);
const path = curve.gap_eV.map((g, i) => `${i ? 'L' : 'M'}${sx(g).toFixed(1)},${sy(curve.efficiency[i]).toFixed(1)}`).join('');
const area = `${path}L${sx(xMax).toFixed(1)},${sy(0)}L${sx(xMin).toFixed(1)},${sy(0)}Z`;
const xTicks: number[] = [];
for (let t = Math.ceil(xMin * 2) / 2; t <= xMax + 1e-9; t += 0.5) xTicks.push(Number(t.toFixed(1)));
const yTicks: number[] = [];
for (let t = 0; t <= yMax + 1e-9; t += 0.1) yTicks.push(Number(t.toFixed(2)));
const pct = (x: number, y: number) => `left:${((sx(x) / W) * 100).toFixed(2)}%;top:${((sy(y) / H) * 100).toFixed(2)}%`;
const optIndex = curve.gap_eV.findIndex((g) => Math.abs(g - optGap) < 1e-9);

const altText = `Shockley–Queisser efficiency limit against band gap. The curve peaks at ${formatText('sq.optimum_gap_eV', optGap, 'eV')} with ${formatText('sq.optimum_efficiency', optEff)}, with a second peak at ${formatText('sq.secondary_peak.gap_eV', secGap, 'eV')}.`;
const geom = JSON.stringify({ W, H, L, R, T, B, xMin, xMax, yMax });
---
<section id="ceiling" class="ceil" aria-labelledby="ceil-h" data-ceiling>
  <div class="ceil__track" data-ceiling-track>
    <div class="ceil__stage">
      <div class="ceil__frame wrap">
        <div class="ceil__panel" data-ceiling-panel data-tone="dark">
          <h2 id="ceil-h" class="ceil__split" aria-label="See the ceiling">
            <span aria-hidden="true">SEE</span>
            <span class="ceil__dot" aria-hidden="true"></span>
            <span aria-hidden="true">CEILING</span>
          </h2>

          <div class="ceil__chart" data-ceiling-chart data-curve={JSON.stringify(curve)} data-geom={geom} data-start={optIndex}>
            <div class="ceil__plot" data-plot>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={altText} data-bound="aria-label">
              {yTicks.map((t) => <line x1={L} x2={W - R} y1={sy(t)} y2={sy(t)} class="grid" />)}
              <path d={area} class="area" />
              <path d={path} class="line" />
              <line x1={sx(optGap)} x2={sx(optGap)} y1={sy(0)} y2={sy(optEff)} class="drop" />
              <circle cx={sx(optGap)} cy={sy(optEff)} r="7" class="dot" />
              <circle cx={sx(secGap)} cy={sy(secEff)} r="5" class="dot dot--hollow" />
              {xTicks.map((t) => <text x={sx(t)} y={H - B + 30} class="tick" text-anchor="middle">{t.toFixed(1)}</text>)}
              {yTicks.map((t) => <text x={L - 12} y={sy(t) + 5} class="tick" text-anchor="end">{Math.round(t * 100)}</text>)}
              <text x={(W + L - R) / 2} y={H - 6} class="axis" text-anchor="middle">Band gap (eV)</text>
              <text x={18} y={(H - B + T) / 2} class="axis" text-anchor="middle" transform={`rotate(-90 18 ${(H - B + T) / 2})`}>Efficiency limit (%)</text>
            </svg>
            <!-- Gap cursor: hidden until the script runs; it reads stored points only. -->
            <div class="ceil__cursor" data-cursor hidden>
              <span class="ceil__cursor-line"></span>
              <span class="ceil__cursor-dot"></span>
              <span class="ceil__cursor-grip" tabindex="0" role="slider" aria-label="Band gap cursor" data-cursor-grip></span>
            </div>
            </div>
            <div class="ceil__mark ceil__mark--opt" style={pct(optGap, optEff)}>
              <span class="t-label">Optimum</span>
              <span class="t-mono"><Num k="sq.optimum_gap_eV" u="eV" /> · <Num k="sq.optimum_efficiency" /></span>
            </div>
            <div class="ceil__mark ceil__mark--sec" style={pct(secGap, secEff)}>
              <span class="t-label">Second peak</span>
              <span class="t-mono"><Num k="sq.secondary_peak.gap_eV" u="eV" /> · <Num k="sq.secondary_peak.efficiency" /></span>
              <span class="ceil__cause"><Num k="sq.secondary_peak.cause" /></span>
            </div>

            <div class="ceil__read" data-cursor-read hidden>
              <span class="t-label">Drag the line</span>
              <span class="ceil__read-v t-mono" aria-live="polite">
                <span data-read-gap><Num k="sq.optimum_gap_eV" u="eV" /></span>
                <span class="ceil__read-arrow" aria-hidden="true">→</span>
                <span data-read-eff><Num k="sq.optimum_efficiency" /></span>
              </span>
              <span class="ceil__read-note">Read straight from the stored curve, one point every <Num k="sq.gap_grid_step_eV" u="eV" />. No interpolation.</span>
            </div>
          </div>

          <dl class="ceil__table t-mono">
            <div><dt>J<sub>sc</sub></dt><dd><Num k="sq.at_optimum.J_sc_mA_cm2" u="mA/cm²" /></dd></div>
            <div><dt>V<sub>oc</sub></dt><dd><Num k="sq.at_optimum.V_oc_V" u="V" /></dd></div>
            <div><dt>V<sub>mp</sub></dt><dd><Num k="sq.at_optimum.V_mp_V" u="V" /></dd></div>
            <div><dt>FF</dt><dd><Num k="sq.at_optimum.fill_factor" /></dd></div>
            <div><dt>P<sub>max</sub></dt><dd><Num k="sq.at_optimum.P_max_mW_cm2" u="mW/cm²" /></dd></div>
          </dl>
          <p class="ceil__note t-small">Detailed balance under AM1.5G sunlight, cell at <Num k="sq.cell_temperature_K" u="K" />. Table values at the optimum gap. The curve is drawn from the stored points.</p>
          <span class="cross ceil__x ceil__x--tl" aria-hidden="true"></span>
          <span class="cross ceil__x ceil__x--tr" aria-hidden="true"></span>
          <span class="cross ceil__x ceil__x--bl" aria-hidden="true"></span>
          <span class="cross ceil__x ceil__x--br" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="ceil__jv wrap" data-fade>
    <Figure name="fig02_jv_curve" alt={`Current–voltage curve of the ideal cell at the optimum gap, with fill factor ${formatText('sq.at_optimum.fill_factor', get('sq.at_optimum.fill_factor'))}.`}>
      The ideal cell at the optimum gap: current against voltage. The maximum-power point sits at <Num k="sq.at_optimum.V_mp_V" u="V" /> and <Num k="sq.at_optimum.J_mp_mA_cm2" u="mA/cm²" />.
    </Figure>
  </div>
</section>

<style>
  .ceil {
    padding-top: clamp(80px, 10vw, 160px);
  }
  .ceil__panel {
    position: relative;
    background: var(--c-blue);
    color: var(--c-white);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 64px);
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: clamp(20px, 3vw, 40px);
  }
  .ceil__split {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.25em;
    font-size: clamp(3rem, 9vw, 11rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .ceil__dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 999px;
    border: 2px solid currentColor;
    display: inline-grid;
    place-items: center;
  }
  .ceil__dot::after {
    content: '';
    width: 30%;
    height: 30%;
    border-radius: 50%;
    background: currentColor;
  }
  .ceil__chart {
    position: relative;
    align-self: center;
    touch-action: pan-y;
  }
  .ceil__plot {
    position: relative;
  }
  .ceil__plot.is-live {
    cursor: ew-resize;
  }
  .ceil__chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ceil__chart .grid {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ceil__chart .area {
    fill: rgba(255, 255, 255, 0.08);
  }
  .ceil__chart .line {
    fill: none;
    stroke: var(--c-white);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .ceil__chart .drop {
    stroke: var(--c-white);
    stroke-dasharray: 4 5;
    vector-effect: non-scaling-stroke;
  }
  .ceil__chart .dot {
    fill: var(--c-white);
  }
  .ceil__chart .dot--hollow {
    fill: var(--c-blue);
    stroke: var(--c-white);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .ceil__chart .tick,
  .ceil__chart .axis {
    fill: rgba(255, 255, 255, 0.75);
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .ceil__chart .axis {
    fill: var(--c-white);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 16px;
  }
  .ceil__mark {
    position: absolute;
    display: grid;
    gap: 2px;
    font-size: 14px;
    pointer-events: none;
    white-space: nowrap;
  }
  .ceil__mark--opt {
    transform: translate(18px, -110%);
  }
  .ceil__mark--sec {
    transform: translate(calc(-100% - 12px), calc(-100% - 8px));
    text-align: right;
  }
  .ceil__cause {
    font-size: 13px;
    opacity: 0.8;
    white-space: normal;
    max-width: 26ch;
    justify-self: end;
  }

  /* Gap cursor */
  .ceil__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    pointer-events: none;
  }
  .ceil__cursor[hidden],
  .ceil__read[hidden] {
    display: none;
  }
  .ceil__cursor-line {
    position: absolute;
    left: -0.5px;
    width: 1px;
    top: var(--plot-top, 5%);
    bottom: var(--plot-bottom, 11%);
    background: var(--c-acid);
  }
  .ceil__cursor-dot {
    position: absolute;
    left: -8px;
    top: calc(var(--y) - 8px);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--c-acid);
    box-shadow: 0 0 0 3px var(--c-blue);
  }
  .ceil__cursor-grip {
    position: absolute;
    left: -22px;
    width: 44px;
    top: var(--plot-top, 5%);
    bottom: var(--plot-bottom, 11%);
    pointer-events: auto;
    cursor: ew-resize;
    border-radius: 22px;
  }
  .ceil__cursor-grip:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }
  .ceil__read {
    position: absolute;
    right: 0;
    top: 0;
    display: grid;
    gap: 4px;
    justify-items: end;
    text-align: right;
    max-width: 30ch;
    pointer-events: none;
  }
  .ceil__read-v {
    font-size: clamp(20px, 1.9vw, 28px);
    color: var(--c-acid);
    white-space: nowrap;
  }
  .ceil__read-arrow {
    opacity: 0.6;
    margin-inline: 0.2em;
  }
  .ceil__read-note {
    font-size: 12px;
    opacity: 0.75;
  }

  .ceil__table {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(20px, 3vw, 48px);
    margin: 0;
    font-size: 15px;
  }
  .ceil__table div {
    display: grid;
    gap: 2px;
  }
  .ceil__table dt {
    opacity: 0.85;
    font-size: 12px;
    text-transform: uppercase;
  }
  .ceil__table dd {
    margin: 0;
    font-size: clamp(18px, 1.6vw, 24px);
  }
  .ceil__note {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }
  .ceil__x {
    position: absolute;
    color: var(--c-white);
  }
  .ceil__x--tl { top: 18px; left: 18px; }
  .ceil__x--tr { top: 18px; right: 18px; }
  .ceil__x--bl { bottom: 18px; left: 18px; }
  .ceil__x--br { bottom: 18px; right: 18px; }
  .ceil__jv {
    margin-top: clamp(40px, 6vw, 100px);
  }
  .ceil__jv :global(.fig__media) {
    max-width: 1100px;
    margin-inline: auto;
  }
  .ceil__jv :global(.fig__cap) {
    margin-inline: auto;
    max-width: 1100px;
  }

  /* WebGL mode (desktop): pinned full-viewport stage; the page canvas draws the growing plane. */
  :global(html.gl-ceil) .ceil__track {
    height: 200vh;
  }
  :global(html.gl-ceil) .ceil__stage {
    position: sticky;
    top: 0;
    height: 100vh;
  }
  :global(html.gl-ceil) .ceil__frame {
    padding: 0;
    height: 100%;
  }
  :global(html.gl-ceil) .ceil__panel {
    height: 100%;
    min-height: 0;
    padding-top: calc(var(--pad-y) + var(--header-h) + 8px);
    background: transparent;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
  }
  :global(html.gl-ceil[data-ceil='open']) .ceil__panel {
    background: var(--c-blue);
  }
  :global(html.gl-ceil) .ceil__split {
    font-size: clamp(3rem, 5.5vw, 6.5rem);
    gap: calc(0.12em + var(--ceil-p, 1) * 0.2em);
    opacity: clamp(0, calc((var(--ceil-p, 1) - 0.5) * 3.4), 1);
  }
  :global(html.gl-ceil) .ceil__chart {
    width: min(100%, calc((100vh - 500px) * 1000 / 560));
    justify-self: center;
  }
  :global(html.gl-ceil) .ceil__chart,
  :global(html.gl-ceil) .ceil__table,
  :global(html.gl-ceil) .ceil__note,
  :global(html.gl-ceil) .ceil__x {
    opacity: clamp(0, calc((var(--ceil-p, 1) - 0.82) * 5.6), 1);
  }
  :global(html.gl-ceil[data-ceil='grow']) .ceil__chart,
  :global(html.gl-ceil[data-ceil='before']) .ceil__chart {
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .ceil__panel {
      min-height: auto;
    }
    .ceil__split {
      font-size: 10.5vw;
      gap: 0.18em;
    }
    .ceil__mark {
      position: static;
      transform: none;
      text-align: left;
      margin-top: 12px;
    }
    .ceil__cause {
      justify-self: start;
    }
    .ceil__read {
      position: static;
      justify-items: start;
      text-align: left;
      margin-top: 16px;
      max-width: none;
    }
  }
</style>
