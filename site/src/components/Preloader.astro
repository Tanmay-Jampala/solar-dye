---
// Black preloader: centred progress bar + giant odometer (000 -> 100), which then rolls into the
// Shockley-Queisser optimum gap read from results.json, holds, and wipes away.
// Only shown when JS runs and motion is allowed (html.preload is set by the inline head script).
import Num from './Num.astro';
---
<div class="pl" aria-hidden="true" data-preloader>
  <div class="pl__bar"><span data-pl-fill></span></div>
  <div class="pl__count" data-pl-count></div>
  <span class="pl__target" data-pl-target><Num k="sq.optimum_gap_eV" /></span>
</div>

<style>
  .pl {
    display: none;
  }
  :global(html.preload) .pl {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--c-black);
    color: var(--c-white);
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.1s var(--ease-3);
  }
  :global(html.preload) .pl.is-done {
    clip-path: inset(0 0 100% 0);
  }
  .pl__bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 130px;
    height: 26px;
    transform: translate(-50%, -50%);
    background: #3a3a3a;
    border-radius: 999px;
    overflow: hidden;
    transition: opacity 0.5s var(--ease-1);
  }
  .pl__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--c-white);
    transform-origin: left;
    transform: scaleX(0);
  }
  .pl.is-morph .pl__bar {
    opacity: 0;
  }
  .pl__count {
    position: absolute;
    left: var(--pad-x);
    bottom: calc(var(--pad-y) - 2vw);
    font-size: 12vw;
    line-height: 1;
    letter-spacing: -0.04em;
    display: flex;
    align-items: baseline;
  }
  .pl__target {
    display: none;
  }
  .pl__count :global(.odo-col) {
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }
  .pl__count :global(.odo-strip) {
    display: flex;
    flex-direction: column;
    transition: transform 0.9s var(--ease-over);
  }
  .pl__count :global(.odo-strip > span) {
    height: 1em;
    line-height: 1;
    text-align: center;
  }
  .pl__count :global(.odo-static) {
    display: inline-block;
    line-height: 1;
  }
  .pl__count :global(.odo-unit) {
    font-size: 0.35em;
    margin-left: 0.25em;
    letter-spacing: 0;
    opacity: 0;
    transform: translateY(0.4em);
    transition: opacity 0.6s var(--ease-1) 0.3s, transform 0.9s var(--ease-expo) 0.3s;
  }
  .pl.is-morph .pl__count :global(.odo-unit) {
    opacity: 1;
    transform: none;
  }
</style>
